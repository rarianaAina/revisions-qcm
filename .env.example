# ---------------------------------------------------------------------------
# Base de données Postgres (obligatoire)
# ---------------------------------------------------------------------------
# Supabase : Project Settings > Database > Connection string > Transaction pooler
# Neon     : Dashboard > Connection string
# Local    : postgresql://postgres:postgres@localhost:5432/revisions
#
# Après l'avoir renseignée, créez les tables : npm run db:setup
DATABASE_URL=

# ---------------------------------------------------------------------------
# Fournisseur LLM (obligatoire — une seule clé suffit)
# ---------------------------------------------------------------------------
# Renseignez PLUSIEURS clés pour obtenir une bascule automatique : si le
# fournisseur principal a son quota épuisé ou tombe en panne, l'application
# passe au suivant, sans intervention.
#
# Laissez LLM_PROVIDER vide pour une détection automatique. L'ordre de
# préférence privilégie les offres gratuites :
#   gemini -> groq -> openai -> anthropic
# LLM_PROVIDER force le fournisseur PRINCIPAL ; les autres clés renseignées
# restent utilisées en secours.
# Valeurs acceptées : gemini | groq | openai | anthropic | ollama
LLM_PROVIDER=

# Mettez LLM_FALLBACK=off pour désactiver la bascule et n'utiliser que le
# fournisseur principal (utile si vous ne voulez surtout pas toucher à une
# offre payante configurée par ailleurs).
LLM_FALLBACK=

# Modèle du fournisseur PRINCIPAL uniquement. Si vide, valeur par défaut :
#   gemini    -> gemini-3.8-flash          (gratuit, recommandé)
#   groq      -> openai/gpt-oss-120b       (gratuit, très rapide)
#   openai    -> gpt-4o-mini               (payant)
#   anthropic -> claude-opus-5             (payant)
LLM_MODEL=

# Pour fixer le modèle d'un fournisseur précis, y compris quand il sert de
# secours, utilisez la variable dédiée :
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=

# --- Gratuit, sans carte bancaire : https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Gratuit, sans carte bancaire : https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Payants ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Modèle local (développement uniquement, inutilisable sur Vercel) ---
# Nécessite LLM_PROVIDER=ollama explicitement.
OLLAMA_BASE_URL=http://127.0.0.1:11434
