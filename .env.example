# ---------------------------------------------------------------------------
# Base de données Postgres (obligatoire)
# ---------------------------------------------------------------------------
# Supabase : Project Settings > Database > Connection string > Transaction pooler
# Neon     : Dashboard > Connection string
# Local    : postgresql://postgres:postgres@localhost:5432/revisions
#
# Après l'avoir renseignée, créez les tables : npm run db:setup
DATABASE_URL=

# ---------------------------------------------------------------------------
# Fournisseur LLM (obligatoire — une seule clé suffit)
# ---------------------------------------------------------------------------
# Laissez LLM_PROVIDER vide pour une détection automatique, dans cet ordre :
#   GEMINI_API_KEY -> ANTHROPIC/OPENAI/GROQ selon ce qui est renseigné.
# Valeurs acceptées : gemini | groq | openai | anthropic | ollama
LLM_PROVIDER=

# Modèle à utiliser. Si vide, valeur par défaut du fournisseur :
#   gemini    -> gemini-3.8-flash          (gratuit, recommandé)
#   groq      -> openai/gpt-oss-120b       (gratuit, très rapide)
#   openai    -> gpt-4o-mini               (payant)
#   anthropic -> claude-opus-5             (payant)
LLM_MODEL=

# --- Gratuit, sans carte bancaire : https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Gratuit, sans carte bancaire : https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Payants ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Modèle local (développement uniquement, inutilisable sur Vercel) ---
# Nécessite LLM_PROVIDER=ollama explicitement.
OLLAMA_BASE_URL=http://127.0.0.1:11434
